<Window x:Class="PhotoSorterApp.Views.SelectOrTypePersonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#1053;&#1072;&#1079;&#1085;&#1072;&#1095;&#1080;&#1090;&#1100; &#1083;&#1080;&#1094;&#1086;"
        Height="420" Width="380" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap"
                   Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,8"/>

        <!-- Filter / new name input -->
        <TextBox Grid.Row="1" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                 Height="30" VerticalContentAlignment="Center" Margin="0,0,0,6"/>

        <!-- Existing persons list -->
        <ListBox Grid.Row="2" ItemsSource="{Binding FilteredNames}"
                 SelectedItem="{Binding SelectedExisting}"
                 Background="{DynamicResource SurfaceBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"/>

        <TextBlock Grid.Row="3" Foreground="{DynamicResource SubtleTextBrush}"
                   FontSize="11" Margin="0,6,0,0">&#1042;&#1074;&#1077;&#1076;&#1080;&#1090;&#1077; &#1085;&#1086;&#1074;&#1086;&#1077; &#1080;&#1084;&#1103; &#1074;&#1074;&#1077;&#1088;&#1093;&#1091; &#1080;&#1083;&#1080; &#1074;&#1099;&#1073;&#1077;&#1088;&#1080;&#1090;&#1077; &#1080;&#1079; &#1089;&#1087;&#1080;&#1089;&#1082;&#1072;.</TextBlock>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="&#1054;&#1050;" Width="90" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Style="{StaticResource SecondaryButton}" Content="&#1054;&#1090;&#1084;&#1077;&#1085;&#1072;" Width="90" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
