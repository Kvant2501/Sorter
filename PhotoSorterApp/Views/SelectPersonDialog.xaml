<Window x:Class="PhotoSorterApp.Views.SelectPersonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#1042;&#1099;&#1073;&#1086;&#1088; &#1087;&#1077;&#1088;&#1089;&#1086;&#1085;&#1099;"
        Height="360" Width="360" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap"
                   Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,8"/>

        <TextBox Grid.Row="1" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                 Height="28" VerticalContentAlignment="Center" Margin="0,0,0,6">
            <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Setter Property="Tag">
                        <Setter.Value>&#1060;&#1080;&#1083;&#1100;&#1090;&#1088;...</Setter.Value>
                    </Setter>
                </Style>
            </TextBox.Style>
        </TextBox>

        <ListBox Grid.Row="2" ItemsSource="{Binding FilteredNames}"
                 SelectedItem="{Binding SelectedName}"
                 Background="{DynamicResource SurfaceBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="&#1042;&#1099;&#1073;&#1088;&#1072;&#1090;&#1100;" Width="110" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Style="{StaticResource SecondaryButton}" Content="&#1054;&#1090;&#1084;&#1077;&#1085;&#1072;" Width="100" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
