<Window x:Class="PhotoSorterApp.Views.PersonsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:PhotoSorterApp.Resources"
        Title="{x:Static res:UiStrings.PersonsWindow_Title}"
        Height="672" Width="1120"
        MinHeight="672" MaxHeight="672"
        MinWidth="1120" MaxWidth="1120"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RequiresPersonSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedPerson}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RequiresPersonDangerButton" TargetType="Button" BasedOn="{StaticResource DangerButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedPerson}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Style="{StaticResource Card}" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <TextBlock Text="{x:Static res:UiStrings.PersonsWindow_HeaderDescription}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SubtleTextBrush}"/>
        </Border>

        <!-- Person list -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Height="28" Margin="0,0,0,8"
                         Text="{Binding PersonSearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"/>

                <ListBox Grid.Row="1" ItemsSource="{Binding Persons}" SelectedItem="{Binding SelectedPerson}"
                         Foreground="{DynamicResource TextBrush}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FaceCount, StringFormat= ({0})}"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           VerticalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Face previews for selected person -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" FontSize="13"
                               Text="{Binding SelectedPerson.DisplayName}"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}" Content="{x:Static res:UiStrings.PersonsWindow_ButtonBack}" Width="80" Height="30" Margin="0,0,6,0"
                                Click="PrevPage_Click" IsEnabled="{Binding CanGoPrevPage}"/>
                        <TextBlock Text="{Binding PageStatusText}" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource SubtleTextBrush}"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="{x:Static res:UiStrings.PersonsWindow_ButtonForward}" Width="80" Height="30"
                                Click="NextPage_Click" IsEnabled="{Binding CanGoNextPage}"/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1">
                    <TextBlock Text="{x:Static res:UiStrings.PersonsWindow_EmptySelectionHint}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPerson}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsLoadingPreviews, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar IsIndeterminate="True" Width="260" Height="8" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding PreviewLoadingText}"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsLoadingPreviews, Converter={StaticResource InverseBoolToVisibility}}">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPerson}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding SelectedFacePreviews}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="5" Columns="10"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="85" Height="85" Margin="3"
                                            CornerRadius="6" BorderThickness="2"
                                            MouseLeftButtonUp="ToggleFaceMark_Click" Cursor="Hand">
                                        <Border.ToolTip>
                                            <ToolTip>
                                                <TextBlock Text="{Binding FileName}"/>
                                            </ToolTip>
                                        </Border.ToolTip>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid ClipToBounds="True">
                                            <Image Source="{Binding Preview}" Stretch="UniformToFill"
                                                   Width="81" Height="81"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <Border CornerRadius="4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                                                <Setter Property="Background" Value="#440078D4"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <Border Width="22" Height="22" CornerRadius="11"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,4,4,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="&#10003;" FontSize="13" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="White">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="{x:Static res:UiStrings.PersonsWindow_ButtonRefresh}" Width="92" Height="30" Margin="0,0,6,0" Click="Refresh_Click"/>
            <Button Style="{StaticResource RequiresPersonSecondaryButton}" Content="{x:Static res:UiStrings.PersonsWindow_ButtonRename}" Width="118" Height="30" Margin="0,0,6,0" Click="Rename_Click"/>
            <Button Style="{StaticResource RequiresPersonSecondaryButton}" Content="{x:Static res:UiStrings.PersonsWindow_ButtonMerge}" Width="118" Height="30" Margin="0,0,6,0" Click="Merge_Click"/>
            <Button Style="{StaticResource DangerButton}" Content="{x:Static res:UiStrings.PersonsWindow_ButtonDeleteMarkedFaces}" Width="165" Height="30" Margin="0,0,6,0" Click="DeleteMarkedFaces_Click" IsEnabled="{Binding HasMarkedFaces}"/>
            <Button Style="{StaticResource RequiresPersonDangerButton}" Content="{x:Static res:UiStrings.PersonsWindow_ButtonDelete}" Width="92" Height="30" Margin="0,0,6,0" Click="Delete_Click"/>
            <Button Style="{StaticResource SecondaryButton}" Content="{x:Static res:UiStrings.PersonsWindow_ButtonClose}" Width="88" Height="30" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>

